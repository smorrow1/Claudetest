{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TODO: your Apple ID email",
        "ascAppId": "TODO: App Store Connect App ID",
        "appleTeamId": "TODO: your Apple Team ID"
      }
    },
    "preview": {
      "ios": {
        "appleId": "TODO: your Apple ID email",
        "ascAppId": "TODO: App Store Connect App ID",
        "appleTeamId": "TODO: your Apple Team ID"
      }
    }
  }
}
